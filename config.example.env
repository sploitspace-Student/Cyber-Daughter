# Salin menjadi config.env lalu isi. JANGAN upload config.env ke GitHub.
# Gunakan bot KHUSUS untuk SOS (buat baru lewat @BotFather), jangan bot pelacak pribadimu.
BOT_TOKEN=isi_token_bot_sos
# ID Telegram orang tua yang menerima peringatan (orang tua sudah menekan Start di bot ini)
CHAT_ID=isi_chat_id_orang_tua
# Nama yang tampil di pesan
NAMA=Nama Anak
